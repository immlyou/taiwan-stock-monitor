# ===========================================
# 台股戰情中心 - 環境變數設定
# ===========================================
# 複製此檔案為 .env 並填入實際數值
# cp .env.example .env

# -------------------------------------------
# FinLab API（必填）
# 取得 Token: https://ai.finlab.tw/
# -------------------------------------------
FINLAB_API_TOKEN=your_finlab_api_token_here

# -------------------------------------------
# X (Twitter) API（選填，社群輿情功能用）
# 取得 Bearer Token: https://developer.twitter.com/
# -------------------------------------------
# X_BEARER_TOKEN=your_x_bearer_token_here

# -------------------------------------------
# LINE Notify（選填，通知功能用）
# 取得 Token: https://notify-bot.line.me/
# -------------------------------------------
# LINE_NOTIFY_TOKEN=your_line_notify_token_here

# -------------------------------------------
# Telegram Bot（選填，通知功能用）
# 建立 Bot: https://t.me/BotFather
# 取得 Chat ID: 發送訊息給 @userinfobot
# -------------------------------------------
# TELEGRAM_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
